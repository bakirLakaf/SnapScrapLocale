{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfigPath": "railway_dari_bot/nixpacks.toml"
  },
  "deploy": {
    "startCommand": "python railway_dari_bot/auto_dari.py",
    "cronSchedule": "0 21 * * *",
    "restartPolicyType": "NEVER"
  }
}
